{
  "name": "backlog-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-libs.mjs",
    "dist": "npm run build && npm pack && node scripts/make-dist.mjs",
    "check": "npm run lint && npm run format && npm run typecheck && npm run test && npm run build",
    "verify:rules": "bash scripts/verify-rules.sh"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "file-type": "^22.0.2",
    "got": "^14.6.6",
    "sonic-boom": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "bin": {
    "backlog-mcp": "dist/main.js"
  },
  "files": [
    "dist"
  ]
}
